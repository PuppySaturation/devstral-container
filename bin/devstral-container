#!/usr/bin/env bash

set -e

# Configuration
CONFIG_DIR="${HOME}/.config/devstral-container"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"

# Colors for output
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Function to show usage
show_usage() {
    cat << EOF
Usage: devstral-container [OPTIONS] [COMMAND]

Run Devstral Vibe CLI in a containerized environment with optional API logging.

OPTIONS:
    --proxy         Enable API request/response logging via proxy
    --no-proxy      Disable proxy (default)
    --datasette     Start Datasette web interface for viewing logs (implies --proxy)
    --migrate-logs  Compact streaming responses in existing logs
    --dry-run       Preview migration without applying changes
    -h, --help      Show this help message

COMMAND:
    Any command to pass to vibe CLI (default: interactive mode)

EXAMPLES:
    devstral-container                    # Interactive mode without logging
    devstral-container --proxy            # Interactive mode with API logging
    devstral-container --datasette        # Interactive mode with logging and web UI
    devstral-container --migrate-logs     # Compact old streaming logs
    devstral-container "analyze the code" # Run specific command

EOF
}

# Parse arguments
ENABLE_PROXY=false
ENABLE_DATASETTE=false
MIGRATE_LOGS=false
DRY_RUN=false
VIBE_COMMAND=""

while [[ $# -gt 0 ]]; do
    case $1 in
        --proxy)
            ENABLE_PROXY=true
            shift
            ;;
        --no-proxy)
            ENABLE_PROXY=false
            shift
            ;;
        --datasette)
            ENABLE_PROXY=true
            ENABLE_DATASETTE=true
            shift
            ;;
        --migrate-logs)
            MIGRATE_LOGS=true
            shift
            ;;
        --dry-run)
            DRY_RUN=true
            shift
            ;;
        -h|--help)
            show_usage
            exit 0
            ;;
        *)
            VIBE_COMMAND="$1"
            shift
            ;;
    esac
done

# Create config directory if it doesn't exist
mkdir -p "${CONFIG_DIR}/config"
mkdir -p "${CONFIG_DIR}/proxy"

# Handle log migration
if [[ "$MIGRATE_LOGS" == true ]]; then
    VERSION="${DEVSTRAL_CONTAINER_VERSION:-0.1.2}"
    DATASETTE_IMAGE="nezhar/devstral-datasette:${VERSION}"

    if [[ ! -f "${CONFIG_DIR}/proxy/logs.db" ]]; then
        echo -e "${YELLOW}No logs database found at ${CONFIG_DIR}/proxy/logs.db${NC}"
        exit 1
    fi

    MIGRATE_ARGS=("/data/logs.db")
    if [[ "$DRY_RUN" == true ]]; then
        MIGRATE_ARGS+=("--dry-run")
        echo -e "${GREEN}Previewing migration (dry run)...${NC}"
    else
        echo -e "${GREEN}Migrating streaming logs to compacted format...${NC}"
    fi

    docker run --rm \
        -v "${CONFIG_DIR}/proxy:/data" \
        "$DATASETTE_IMAGE" \
        migrate-logs "${MIGRATE_ARGS[@]}"
    exit 0
fi

# Store the original working directory before changing to project dir
export WORKSPACE_DIR="${PWD}"

CONFIG_FILE="${CONFIG_DIR}/config/config.toml"
CONFIG_BACKUP="${CONFIG_DIR}/config/config.toml.backup"

if [[ "$ENABLE_PROXY" == true ]]; then
    echo -e "${GREEN}Starting with API logging enabled${NC}"

    # Backup existing config if it exists and hasn't been backed up yet
    if [[ -f "$CONFIG_FILE" ]] && [[ ! -f "$CONFIG_BACKUP" ]]; then
        cp "$CONFIG_FILE" "$CONFIG_BACKUP"
    fi

    # Create or update config.toml with proxy provider
    cat > "$CONFIG_FILE" << 'EOF'
# Mistral Vibe configuration with proxy enabled
# Original config backed up to config.toml.backup

[[providers]]
name = "mistral"
api_base = "http://devstral-proxy:8080/v1"
api_key_env_var = "MISTRAL_API_KEY"
api_style = "openai"
backend = "generic"
EOF

    if [[ "$ENABLE_DATASETTE" == true ]]; then
        echo -e "${GREEN}Datasette will be available at http://localhost:8001${NC}"
    fi
else
    # Restore original config if backup exists, otherwise remove proxy config
    if [[ -f "$CONFIG_BACKUP" ]]; then
        mv "$CONFIG_BACKUP" "$CONFIG_FILE"
    elif [[ -f "$CONFIG_FILE" ]]; then
        # Remove proxy config so vibe uses its defaults (direct to Mistral)
        rm "$CONFIG_FILE"
    fi
fi

# Set image details
VERSION="${DEVSTRAL_CONTAINER_VERSION:-0.1.2}"
IMAGE="nezhar/devstral-cli:${VERSION}"
PROXY_IMAGE="nezhar/devstral-proxy:${VERSION}"
DATASETTE_IMAGE="nezhar/devstral-datasette:${VERSION}"
NETWORK_NAME="devstral-network"
PROXY_CONTAINER_NAME="devstral-proxy"
DATASETTE_CONTAINER_NAME="devstral-datasette"

# Start background services if needed
if [[ "$ENABLE_PROXY" == true ]]; then
    echo -e "${YELLOW}Starting proxy services...${NC}"

    # Create network if it doesn't exist
    docker network create "$NETWORK_NAME" 2>/dev/null || true

    # Start proxy container
    docker run -d --rm \
        --name "$PROXY_CONTAINER_NAME" \
        --network "$NETWORK_NAME" \
        -p 8080:8080 \
        -v "${CONFIG_DIR}/proxy:/proxy/logs" \
        "$PROXY_IMAGE" 2>/dev/null || true

    if [[ "$ENABLE_DATASETTE" == true ]]; then
        # Start datasette container
        docker run -d --rm \
            --name "$DATASETTE_CONTAINER_NAME" \
            --network "$NETWORK_NAME" \
            -p 8001:8001 \
            -v "${CONFIG_DIR}/proxy:/data" \
            "$DATASETTE_IMAGE" 2>/dev/null || true

        echo -e "${GREEN}Datasette will be available at http://localhost:8001${NC}"
    fi

    # Wait for proxy to be ready
    sleep 2
fi

# Prepare docker run command
DOCKER_ARGS=(
    --rm -it
    --user "$(id -u):$(id -g)"
    -v "${WORKSPACE_DIR}:/workspace"
    -v "${CONFIG_DIR}/config:/root/.vibe"
)

# Add network configuration if proxy is enabled
if [[ "$ENABLE_PROXY" == true ]]; then
    DOCKER_ARGS+=(
        --network "$NETWORK_NAME"
    )
fi

# Run the CLI
if [[ -z "$VIBE_COMMAND" ]]; then
    # Interactive mode
    docker run "${DOCKER_ARGS[@]}" "$IMAGE"
else
    # Command mode
    docker run "${DOCKER_ARGS[@]}" "$IMAGE" vibe "$VIBE_COMMAND"
fi

# Cleanup
if [[ "$ENABLE_PROXY" == true ]]; then
    echo -e "${YELLOW}Proxy services are still running. To stop them, run:${NC}"
    echo -e "${YELLOW}  docker stop $PROXY_CONTAINER_NAME${NC}"
    if [[ "$ENABLE_DATASETTE" == true ]]; then
        echo -e "${YELLOW}  docker stop $DATASETTE_CONTAINER_NAME${NC}"
    fi
fi
