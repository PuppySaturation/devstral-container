FROM python:3.12-slim

# Install mitmproxy
RUN pip install --no-cache-dir mitmproxy

# Create directory for logs, scripts, and mitmproxy config
RUN mkdir -p /proxy/logs /proxy/certs

# Copy the proxy script
COPY proxy_script.py /proxy/proxy_script.py

WORKDIR /proxy

# Expose proxy port
EXPOSE 8080

# Run mitmproxy in reverse proxy mode to intercept and forward to Mistral API
CMD ["mitmdump", "--set", "confdir=/proxy/certs", "-s", "/proxy/proxy_script.py", "--listen-host", "0.0.0.0", "--listen-port", "8080", "--mode", "reverse:https://api.mistral.ai", "--ssl-insecure"]
